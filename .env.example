# Server (local development)
PORT=4000
HOST=0.0.0.0

# Admin panel bootstrap password. REQUIRED in production (Vercel/Railway) —
# the server refuses to start without it. Must be a strong, unique value,
# 12+ characters, and NOT the old default. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_PASSWORD=change-me-to-a-strong-unique-value

# Token-signing secret. REQUIRED in production — the server refuses to sign
# or verify admin tokens without it, and NEVER derives one from the
# password. Generate at least 48 random bytes, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SECRET=change-me-to-a-64-char-hex-string-from-crypto-randomBytes-48

# Persistent data folder for the database and uploaded files (set to /data on Railway with a volume)
# DATA_DIR=/data

# Frontend dev proxy target (optional; defaults to http://localhost:4000)
# VITE_API_URL=http://localhost:4000

# Media audit script base URL (optional)
# MEDIA_BASE=http://localhost:4000

# Set automatically on Vercel — do not set locally unless testing serverless behavior
# VERCEL=1
